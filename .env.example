# Jupiter API (optional — used for price data fallback)
JUPITER_API_KEY=your_jupiter_api_key_here
NEXT_PUBLIC_JUPITER_API_KEY=your_jupiter_api_key_here

# Helius API (required for DAS metadata, WebSocket monitoring, and webhooks)
# Get your key at: https://dashboard.helius.dev
HELIUS_API_KEY=your_helius_api_key_here

# Indexer protection — set a strong random secret to prevent unauthorized indexing
# POST /api/indexer requires: Authorization: Bearer <this value>
# Leave empty to allow open access in development
INDEXER_SECRET=

# Helius webhook shared secret — set in Helius dashboard when creating the webhook
# Ensures /api/webhooks/helius only accepts POST from Helius
# Leave empty to accept all requests in development
HELIUS_WEBHOOK_SECRET=

# HTTP/HTTPS proxy (optional — may help bypass Cloudflare on GMGN API in some environments)
# HTTPS_PROXY=http://your-proxy:port
